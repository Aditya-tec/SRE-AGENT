PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GROQ_API_KEY=

RENDER_API_KEY=
RENDER_SERVICE_IDS={"order-service-a":"","order-service-b":"","inventory-service":"","notification-service":""}

ORDER_A_URL=http://localhost:3001
ORDER_B_URL=http://localhost:3011
INVENTORY_URL=http://localhost:3002
NOTIFICATION_URL=http://localhost:3003

DISCORD_WEBHOOK_URL=

# Optional. Shared secret sent as x-chaos-secret when calling target
# services' /chaos — must match the same CHAOS_SECRET set on all 4
# target services. Leave unset for local dev (chaos endpoints stay
# open in that case).
CHAOS_SECRET=

# Optional. Comma-separated list of origins allowed to call this API
# (e.g. https://your-dashboard.vercel.app). Leave unset to allow all
# origins — fine for local dev, worth tightening once the dashboard
# has a fixed production URL.
DASHBOARD_ORIGIN=
